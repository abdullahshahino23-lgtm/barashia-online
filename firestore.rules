rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'abdullah.shahino23@gmail.com';
    }
    function d() { return request.resource.data; }

    // مقدمو الخدمة
    match /providers/{id} {
      allow read: if isAdmin() || resource.data.approved == true;
      allow create: if isAdmin() || (
        d().approved == false &&
        d().keys().hasOnly(['n','c','p','w','a','h','d','fb','img','hv','t','approved','lat','lng']) &&
        d().n is string && d().n.size() > 0 && d().n.size() <= 80 &&
        d().p is string && d().p.size() <= 20 &&
        d().d.size() <= 300 && d().img.size() <= 200000 &&
        (!('lat' in d()) || d().lat is number) &&
        (!('lng' in d()) || d().lng is number));
      allow update, delete: if isAdmin();
    }

    // التقييمات
    match /reviews/{id} {
      allow read: if isAdmin() || resource.data.approved == true;
      allow create: if d().approved == true &&
        d().keys().hasOnly(['pid','n','s','x','t','approved']) &&
        d().s is int && d().s >= 1 && d().s <= 5 &&
        d().x.size() <= 300 && d().n.size() <= 40;
      allow update, delete: if isAdmin();
    }

    // طلبات التوصيل
    match /orders/{id} {
      allow create: if d().st == 'جديد' && d().fee == 15 &&
        d().keys().hasOnly(['k','pid','pn','cn','cp','ca','x','pr','fee','st','t']) &&
        d().cp.size() <= 20 && d().ca.size() <= 120 && d().x.size() <= 300;
      allow read, update, delete: if isAdmin();
    }

    // السوق (بيع وشراء)
    match /offers/{id} {
      allow read: if isAdmin() || resource.data.approved == true;
      allow create: if d().approved == false &&
        d().keys().hasOnly(['k','n','pr','d','cn','p','img','approved','t']) &&
        d().k in ['sell','buy'] && d().pr is number && d().pr >= 0 &&
        d().n.size() <= 80 && d().d.size() <= 300 && d().img.size() <= 200000;
      allow update, delete: if isAdmin();
    }

    // الإعلانات
    match /news/{id} {
      allow read: if isAdmin() || resource.data.approved == true;
      allow create, update, delete: if isAdmin();
    }

    // المقترحات
    match /suggestions/{id} {
      allow read: if isAdmin() || resource.data.approved == true;
      allow create: if d().approved == true &&
        d().keys().hasOnly(['n','c','ti','x','approved','t']) &&
        d().x is string && d().x.size() > 0 && d().x.size() <= 500 &&
        d().n.size() <= 40 && d().ti.size() <= 80 && d().c.size() <= 30;
      allow update, delete: if isAdmin();
    }

    // الإعلانات والمناسبات
    match /announcements/{id} {
      allow read: if isAdmin() || resource.data.approved == true;
      allow create: if isAdmin() || (
        d().approved == false &&
        d().keys().hasOnly(['ty','ti','x','dt','pl','u','cn','t','approved']) &&
        d().ty in ['فرح','وفاة','مناسبة','تنبيه','عرض'] &&
        d().ti is string && d().ti.size() > 0 && d().ti.size() <= 100 &&
        d().x.size() <= 400 && d().dt.size() <= 100 && d().pl.size() <= 100 &&
        d().u.size() <= 10 && d().cn.size() <= 60);
      allow update, delete: if isAdmin();
    }

    // الأرقام المهمة
    match /numbers/{id} {
      allow read: if isAdmin() || resource.data.approved == true;
      allow create, update, delete: if isAdmin();
    }

    // المحادثات
    match /chats/{cid} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isAdmin() || (d().from == 'user' && d().last.size() <= 200);
      allow delete: if isAdmin();

      match /messages/{mid} {
        allow read: if true;
        allow create: if isAdmin() || (d().from == 'user' && d().x.size() <= 500);
        allow update: if false;
        allow delete: if isAdmin();
      }
    }
  }
}
